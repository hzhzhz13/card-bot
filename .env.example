# Discord bot credentials — get these from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here

# Optional: restrict slash-command registration to a single guild for instant updates during dev.
# Leave blank to register commands globally (can take up to 1 hour to propagate).
GUILD_ID=

# Comma-separated Discord user IDs allowed to run admin commands (/spawn, /give)
ADMIN_IDS=

# Gameplay tuning (values in milliseconds unless noted)
DROP_COOLDOWN_MS=300000      # 5 minutes between /drop per player
CLAIM_COOLDOWN_MS=120000     # 2 minutes between claims per player
DROP_PRIORITY_MS=10000       # 10s dropper-priority window
DROP_EXPIRY_MS=30000         # 30s until a drop expires

# Economy tuning
DAILY_BASE_REWARD=100        # base coins from /daily
DAILY_STREAK_BONUS=10        # extra coins per consecutive day
DAILY_STREAK_MAX_BONUS=100   # cap on the streak bonus
DAILY_COOLDOWN_MS=86400000   # 24h between /daily claims
CONFIRM_TIMEOUT_MS=60000     # how long /trade and /burn confirmations stay valid
